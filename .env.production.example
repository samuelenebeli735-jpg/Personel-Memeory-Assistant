# =============================================================================
# Recall - production template for the Docker/Caddy stack
# Copy to `.env.production`, replace every placeholder, and never commit it.
# =============================================================================

# Public DNS name. A real name makes Caddy obtain and renew HTTPS certificates.
# Use `:80` only for a local HTTP smoke test (and expect cookie login to fail
# because COOKIE_SECURE is true).
RECALL_DOMAIN=recall.example.com

# Host UID/GID used by the one-shot backup container. On Linux:
#   mkdir -p backups && sudo chown 1000:1000 backups
RECALL_UID=1000
RECALL_GID=1000

# --- Core -------------------------------------------------------------------
NODE_ENV=production
# The app is reachable only through the compose network; Caddy publishes 80/443.
HOST=0.0.0.0
PORT=4000
# Caddy runs on a private Docker bridge address. Do not enable proxy trust when
# clients can connect to the app directly.
TRUST_PROXY=172.16.0.0/12

# --- Database ---------------------------------------------------------------
# Persistent volume mounted at /data. Do not point this at the repository.
DATABASE_URL=file:/data/recall.db

# --- Owner identity ---------------------------------------------------------
TELEGRAM_OWNER_IDS=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_URL=https://recall.example.com/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

# --- Dashboard authentication ----------------------------------------------
# Production validation rejects these placeholders and short values. The stack
# must not start until both are replaced with generated secrets.
DASHBOARD_PASSWORD=changeme
SESSION_SECRET=changeme
CORS_ORIGINS=https://recall.example.com
SESSION_TTL_HOURS=168
# Required in production; Caddy terminates HTTPS.
COOKIE_SECURE=true

# --- Locale / scheduling ----------------------------------------------------
DEFAULT_TIME_ZONE=Africa/Lagos
DEFAULT_MORNING_TIME=09:00
DEFAULT_EVENING_TIME=19:00
SCHEDULER_INTERVAL_SECONDS=20
QUIET_HOURS_START=
QUIET_HOURS_END=
MAX_NOTIFICATIONS_PER_DAY=0
REMINDER_OVERDUE_GRACE_HOURS=12
REMINDER_MAX_ATTEMPTS=5
REMINDER_RETRY_BASE_SECONDS=30

# --- Optional AI/STT --------------------------------------------------------
# Keep both off for the first deployment. AI_MODEL is required with a provider.
# AI_BASE_URL empty = the provider's own endpoint. Your text is sent to the
# provider only if AI_ALLOW_RAW_TEXT=true (default false).
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
AI_ALLOW_RAW_TEXT=false

STT_PROVIDER=none
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
STT_RETAIN_AUDIO=false
STT_AUDIO_DIR=/data/audio
STT_MAX_AUDIO_SECONDS=180
STT_MAX_AUDIO_BYTES=26214400

# --- Daily briefing ---------------------------------------------------------
BRIEFING_ENABLED=false
BRIEFING_TIME=07:30

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
LOG_MESSAGE_CONTENT=false
