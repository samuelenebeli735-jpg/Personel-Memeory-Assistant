# Dependencies
node_modules/
.npm/

# Build output
dist/
build/
*.tsbuildinfo

# Environment / secrets  (NEVER commit real credentials)
.env
.env.*
!.env.example
!.env.production.example

# Databases (personal data - never commit)
*.db
*.db-journal
*.db-wal
*.db-shm
apps/server/prisma/*.db
apps/server/prisma/*.db-journal
prisma/data/

# Logs
logs/
*.log
npm-debug.log*

# Browser E2E output / disposable E2E database and credentials
apps/web/e2e/.tmp/
test-results/
playwright-report/

# Local configuration
apps/server/config/local.json
apps/web/.env.local

# Backups / exports of personal data
backups/
exports/

# Retained voice audio (STT_RETAIN_AUDIO=true)
data/

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
