# =============================================================================
# Recall - environment template
# Copy to `.env` and fill in real values locally. NEVER commit the real `.env`.
# Every value below is a placeholder.
# =============================================================================

# --- Core -------------------------------------------------------------------
# `development` | `test` | `production`
NODE_ENV=development
# Bind address for the HTTP API / dashboard backend.
HOST=127.0.0.1
PORT=4000
# Trust X-Forwarded-For only from a known reverse proxy. false is the safe
# default. Accepts true, an address/CIDR, or a comma-separated list.
TRUST_PROXY=false

# --- Database ---------------------------------------------------------------
# SQLite file. Relative paths resolve against `apps/server/prisma/`.
# For production put this on a persistent volume, e.g. file:/data/recall.db
DATABASE_URL="file:./dev.db"

# --- Owner identity ---------------------------------------------------------
# Only this Telegram user id may talk to the bot. Get it from @userinfobot.
# Comma-separated list is supported for multiple owners. The example id below is
# rejected when TELEGRAM_ENABLED=true.
TELEGRAM_OWNER_IDS=123456789

# --- Telegram bot (optional at first; text capture needs it) ----------------
# Create a bot with @BotFather. Placeholder value below will FAIL validation if
# TELEGRAM_ENABLED=true.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=false
# `polling` (local dev, no public URL) or `webhook` (production).
TELEGRAM_MODE=polling
# Required when TELEGRAM_MODE=webhook. Full public HTTPS URL of
# POST /api/telegram/webhook, with no trailing slash.
TELEGRAM_WEBHOOK_URL=
# Random string used to verify webhook calls (Telegram `secret_token`).
TELEGRAM_WEBHOOK_SECRET=

# --- Dashboard authentication ----------------------------------------------
# Owner login password for the web dashboard. Production requires at least
# 12 characters; use a long random value and do not use "password"/"changeme".
DASHBOARD_PASSWORD=
# Secret used to sign dashboard session cookies. Production requires at least
# 32 random characters, not a repeated or placeholder pattern.
SESSION_SECRET=
# Browser origin allowed to call the API (comma separated).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Session lifetime in hours.
SESSION_TTL_HOURS=168
# Set true only when serving over HTTPS behind a trusted proxy.
COOKIE_SECURE=false

# --- Locale / scheduling ----------------------------------------------------
# IANA time zone used for interpreting and displaying local times.
DEFAULT_TIME_ZONE=Africa/Lagos
# Default local time used for vague expressions such as "tomorrow morning".
DEFAULT_MORNING_TIME=09:00
DEFAULT_EVENING_TIME=19:00
# How often the scheduler wakes up, in seconds.
SCHEDULER_INTERVAL_SECONDS=20
# Stop sending reminders during quiet hours (local time, HH:MM). Empty = off.
QUIET_HOURS_START=
QUIET_HOURS_END=
# Max reminder notifications delivered per local day. 0 = unlimited.
MAX_NOTIFICATIONS_PER_DAY=0
# Reminders older than this many hours are marked missed instead of fired late.
REMINDER_OVERDUE_GRACE_HOURS=12
# Bounded retry/backoff for reminder delivery.
REMINDER_MAX_ATTEMPTS=5
REMINDER_RETRY_BASE_SECONDS=30

# --- AI provider (optional) -------------------------------------------------
# `none` keeps the app fully functional with deterministic rules only.
# Supported: none | openai | openai-compatible | anthropic
AI_PROVIDER=none
AI_API_KEY=
# Must be an http(s) URL without embedded credentials or a fragment. Outside
# development, plain http:// is allowed only for loopback hosts.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
# Send capture text to the AI provider? Defaults to true. Enabling an AI
# provider therefore shares raw capture text unless this is explicitly false.
AI_ALLOW_RAW_TEXT=true

# --- Speech-to-text provider (optional) ------------------------------------
# Supported: none | openai
STT_PROVIDER=none
STT_API_KEY=
# Must be an http(s) URL without embedded credentials or a fragment. Outside
# development, plain http:// is allowed only for loopback hosts.
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
# Keep raw Telegram voice files on disk after transcription? Default: no.
STT_RETAIN_AUDIO=false
# Directory used only when STT_RETAIN_AUDIO=true. Never served by the API.
STT_AUDIO_DIR=./data/audio
# Refuse audio longer than this (Telegram voice duration).
STT_MAX_AUDIO_SECONDS=180
# Refuse downloads larger than this many bytes while streaming, before upload.
STT_MAX_AUDIO_BYTES=26214400

# --- Daily briefing (optional) ---------------------------------------------
BRIEFING_ENABLED=false
# Local time HH:MM in DEFAULT_TIME_ZONE.
BRIEFING_TIME=07:30

# --- Logging ----------------------------------------------------------------
# `fatal` | `error` | `warn` | `info` | `debug` | `trace` | `silent`
LOG_LEVEL=info
# Never log raw capture text / transcripts when false (default).
LOG_MESSAGE_CONTENT=false
