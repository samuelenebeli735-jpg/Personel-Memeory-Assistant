# Recall production reverse proxy.
#
# RECALL_DOMAIN is supplied by compose from .env.production. A real DNS name
# enables Caddy's automatic HTTPS (Let's Encrypt/ZeroSSL); use `:80` only for a
# local HTTP smoke test.
{
	admin off
}

{$RECALL_DOMAIN} {
	encode zstd gzip

	@api path /api/*
	handle @api {
		reverse_proxy app:4000
	}

	handle {
		# Dashboard Content-Security-Policy (R3-03). Must stay identical to
		# DASHBOARD_CSP in apps/web/src/csp.ts; a unit test checks it. The API
		# sends its own, stricter policy.
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# Access log without query strings (R3-03): a query can hold search words,
	# a restore file's hash or a token. The request URI and the Referer header
	# are logged as path only, like the app's own log. Cookie and Authorization
	# headers are already redacted by Caddy by default.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "[?].*$" ""
				request>headers>Referer regexp "[?].*$" ""
			}
		}
	}
}
